; Godot 4.7 project: GhostADS renderer (render only, no physics / no AI)
config_version=5

[application]
config/name="GhostRender"
run/main_scene="res://main.tscn"
run/low_processor_mode=false

[display]
window/size/viewport_width=64
window/size/viewport_height=64
window/vsync/vsync_mode=0

[physics]
common/physics_ticks_per_second=1

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
